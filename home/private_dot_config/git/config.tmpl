[user]
	name = "uzvg"
	email =  "uzvg@qq.com"
[core]
	editor = nvim{{ if eq .chezmoi.os "linux" }}
	hooksPath = /home/uzvg/.config/git/hooks{{ end }}
[init]
	defaultBranch = main
[diff]
	tool = nvimdiff
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[merge "ours"]
	driver = true
[pull]
	rebase = true
[credential "https://github.com"]
	helper ={{ " " }}
	helper = !{{ if eq .chezmoi.os "windows" }}{{ else }}/usr/bin/{{ end }}gh auth git-credential
[credential "https://gist.github.com"]
	helper ={{ " " }}
	helper = !{{ if eq .chezmoi.os "windows" }}{{ else }}/usr/bin/{{ end }}gh auth git-credential
