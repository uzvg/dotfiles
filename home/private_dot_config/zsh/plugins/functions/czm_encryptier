# vim:et sts=2 sw=2 ft=zsh

emulate -L zsh
setopt err_return no_unset pipe_fail

# 参数检查必须放在 $1/$2 之前，否则 no_unset 会先报 "parameter not set"
if (( $# != 2 )); then
  _zlog error "参数错误。"
  _zlog info "正确格式：czm_encryptier key_name key_text_or_file"
  return 1
fi

local key_name=$1
local key_text

# 第二参数是文件路径时直接读取；末尾换行会被去掉，模板侧本来也 trim
if [[ -f $2 ]]; then
  key_text=$(<"$2")
  _zlog info "从文件读取：$2"
else
  key_text=$2
fi
local target_key_file="$(chezmoi source-path)/secrets/keys/${key_name}.txt.age"
local public_key="age1tdeka5y0ykzutvst00sk30f0mrx8z45e42tv97h3xqnzn9us4v4qt7f87g"
local reference_text='{{ include (joinPath .chezmoi.sourceDir "secrets/keys/'"${key_name}"'.txt.age") | decrypt | trim }}'

if (( ! ${+commands[age]} )); then
  _zlog error "age 命令未找到"
  return 1
fi

# 文件已存在检查
if [[ -f $target_key_file ]]; then
  _zlog error "$target_key_file 已经存在，请重新选择 key_name"
  return 1
fi

# 确保目录存在
mkdir -p -- "$(dirname -- "$target_key_file")"

# 加密
if print -r -- "$key_text" | age --encrypt --armor -r "$public_key" -o "$target_key_file"; then
  _zlog success "秘钥加密成功"
  _zlog info "秘钥文件位置：$target_key_file"

  if (( ${+commands[wl-copy]} )) && print -r -- "$reference_text" | wl-copy; then
    _zlog info "你可以使用如下字符引用：$reference_text"
  else
    _zlog warn "wl-copy 不可用，请手动复制下面的引用："
    print -r -- "$reference_text"
  fi
else
  _zlog error "加密失败"
  return 1
fi
