# vim:et sts=2 sw=2 ft=zsh

# elio 文件管理器的 zsh shell 集成，等价于 `elio shell init zsh`。
#
# 相比官方生成的脚本做了以下优化：
#   - 用 `$@[(I)pattern]` 一次性完成参数扫描，省掉逐参数 for 循环
#   - 用 `always` 块清理临时文件，Ctrl-C / 异常退出时不会残留
#   - `$(<file)` 由 zsh 直接读取，省掉 `cat` 子进程
#   - 用户显式传入 --cwd-file 时完全透传，不覆盖其行为

emulate -L zsh

# shell / portal 子命令与 -h / --version 等选项：直接透传，不做目录跟随
if [[ ${1-} == (shell|portal|-*) ]]; then
  command elio "$@"
  return $?
fi

# 调用方自行管理输出时（--chooser-file / --cwd-file），不做任何包装
if (( ${@[(I)--chooser-file*]} || ${@[(I)--cwd-file*]} )); then
  command elio "$@"
  return $?
fi

local tmp cwd ret=0
tmp=$(mktemp "${TMPDIR:-/tmp}/elio-cwd.XXXXXXXXXX") || {
  print -u2 -r -- "elio: 无法创建临时文件"
  return 1
}

{
  command elio --cwd-file "$tmp" "$@"
  ret=$?
} always {
  if [[ -s $tmp ]]; then
    cwd=$(<"$tmp")
    # elio 退出时的目录与当前目录不同且确实存在时才切换
    if [[ -n $cwd && $cwd != $PWD && -d $cwd ]]; then
      builtin cd -- "$cwd" || ret=$?
    fi
  fi
  command rm -f -- "$tmp"
}

return $ret
