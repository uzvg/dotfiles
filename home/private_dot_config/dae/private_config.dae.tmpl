# dae 配置
# 文档：https://github.com/daeuniverse/dae/tree/main/docs/zh/configuration

global {
    log_level: info

    # 延迟差在此范围内不切换节点，避免在毫秒级抖动上来回抢选
    check_tolerance: 50ms

    # 只代理本机流量；需要代理局域网设备时再设 lan_interface
    wan_interface: auto
    enable_local_tcp_fast_redirect: true

    # 按域名分流；DNS 必须经过 dae
    dial_mode: domain

    # 仅用于启动阶段解析 DoH 域名和节点域名，不参与日常查询
    bootstrap_resolver: '223.5.5.5:53'
}

dns {
    # 只返回 IPv4，避免应用走 IPv6 绕过代理
    ipversion_prefer: 4

    upstream {
        # 国内域名：阿里 DoH，直连
        alidns: 'https://dns.alidns.com/dns-query'
        # 国外域名：Cloudflare DoH，走代理
        cfdns: 'https://1.1.1.1/dns-query'
    }

    routing {
        request {
            qname(geosite:category-ads-all) -> reject
            # 局域网主机名交给路由器
            qname(suffix: lan) -> asis
            qname(geosite:cn) -> alidns
            # dae 自己拉订阅/解析节点域名时直连，避免启动死锁
            sub(any) -> alidns
            subnode(any) -> alidns
            fallback: cfdns
        }

        response {
            # Cloudflare 的结果可信
            upstream(cfdns) -> accept
            qname(suffix: lan) -> accept
            # 非国内域名返回私网 IP，回查 cfdns 防污染
            ip(geoip:private) && !qname(geosite:cn) -> cfdns
            fallback: accept
        }
    }
}

subscription {
    chuixueyun: {{ include (joinPath .chezmoi.sourceDir "secrets/keys/chuixueyun.txt.age") | decrypt | trim | quote}}
}

group {
    proxy {
        # 只选日本节点
        filter: subtag(chuixueyun) && name(keyword: '日本')
        # min_avg10 取最近 10 次检测的平均，比 min_moving_avg 更抗单次抖动
        policy: min_avg10
    }
}

routing {
    # DNS 规则必须先于 pname 规则：NetworkManager 的连通性探测会解析
    # ping.archlinux.org，走 cfdns 拨 1.1.1.1:443；若被判为直连必然超时
    dip(1.1.1.1) && dport(443) -> proxy
    dip(223.5.5.5) && dport(53) -> must_direct

    # NetworkManager 自身流量直连
    pname(NetworkManager) -> direct

    # 组播/广播、私网直连
    dip(224.0.0.0/3, 'ff00::/8') -> must_direct
    dip(geoip:private) -> direct

    # 国内直连
    dip(geoip:cn) -> direct
    domain(geosite:cn) -> direct
    domain(suffix: alidns.com) -> direct
    # 自定义站点；不再使用可删
    domain(suffix: kukuw.com) -> direct

    # 其余全部走代理（含 Cloudflare DoH）
    fallback: proxy
}
