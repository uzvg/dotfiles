{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": {{ if eq .chezmoi.os "windows" }}"system"{{ else }}"ayu"{{ end }}
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  }
}
